{
  "name": "jaeung-me",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm datagen && concurrently \"next dev \" \"pnpm datagen --watch\"",
    "build": "pnpm datagen && next build ",
    "start": "next start",
    "prestart": "pnpm datagen",
    "lint": "eslint .",
    "format": "prettier --write .",
    "postbuild": "pagefind --site .next/server/app --output-path public/_pagefind",
    "prepare": "husky",
    "datagen": "node generate-data.js -i ./data -o ./data -a data-accessor.ts -x"
  },
  "dependencies": {
    "@giscus/react": "^3.1.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@next/third-parties": "^16.3.6",
    "@supabase/supabase-js": "^2.117.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/og": "^1.0.3",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "katex": "^0.18.7",
    "mime-types": "^3.0.2",
    "next": "^16.3.6",
    "next-themes": "^0.4.6",
    "next-view-transitions": "^0.3.5",
    "nextra": "^4.6.1",
    "nextra-theme-blog": "^4.6.1",
    "react": "^19.3.0",
    "react-devicons": "^2.16.2",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.7.0",
    "theme-change": "^3.0.4",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/js-yaml": "^4.0.9",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "chokidar": "^5.0.0",
    "concurrently": "^10.0.5",
    "daisyui": "^5.7.43",
    "eslint": "^10.11.0",
    "eslint-config-next": "16.3.6",
    "husky": "^9.1.7",
    "js-yaml": "^5.4.2",
    "lint-staged": "^17.5.1",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "quicktype-core": "^26.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,md,mdx}": [
      "prettier --write"
    ]
  }
}
